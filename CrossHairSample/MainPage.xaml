<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CrossHairSample.MainPage"    
             xmlns:chart="clr-namespace:Syncfusion.Maui.Charts;assembly=Syncfusion.Maui.Charts"
             xmlns:model="clr-namespace:CrossHairSample.Viewmodel">

    <ContentPage.BindingContext>
        <model:CloudDataViewModel/>
    </ContentPage.BindingContext>

    <chart:SfCartesianChart>
        
        <chart:SfCartesianChart.Title>
            <Label Text="Market Share for Cloud Infrastructure" FontSize="20" HorizontalTextAlignment="Center"></Label>
        </chart:SfCartesianChart.Title>

        <chart:SfCartesianChart.XAxes>
            <chart:CategoryAxis ShowTrackballLabel="True">
                <chart:CategoryAxis.Title>
                    <chart:ChartAxisTitle Text="Company"/>
                </chart:CategoryAxis.Title>
                <chart:CategoryAxis.TrackballLabelStyle>
                    <chart:ChartAxisLabelStyle Background="LightBlue"   
                                      FontSize="15" 
                                      CornerRadius="5"
                                      StrokeWidth="2" 
                                      Stroke="Gray"/>
                </chart:CategoryAxis.TrackballLabelStyle>
            </chart:CategoryAxis>
        </chart:SfCartesianChart.XAxes>

        <chart:SfCartesianChart.YAxes>
            <chart:NumericalAxis ShowTrackballLabel="True">
                <chart:NumericalAxis.Title>
                    <chart:ChartAxisTitle Text="MarketShare in %"/>
                </chart:NumericalAxis.Title>
                <chart:NumericalAxis.TrackballLabelStyle>
                    <chart:ChartAxisLabelStyle Background="LightBlue"   
                                      FontSize="15" 
                                      CornerRadius="5"
                                      StrokeWidth="2" 
                                      Stroke="Gray"/>
                </chart:NumericalAxis.TrackballLabelStyle>
            </chart:NumericalAxis>
        </chart:SfCartesianChart.YAxes>

        <!--Initialize the series for chart-->
        <chart:ColumnSeries ItemsSource="{Binding CloudData}"
                            XBindingPath="Company" CornerRadius="20,20,0,0"
                            YBindingPath="MarketShare">
        </chart:ColumnSeries>

        <chart:SfCartesianChart.CrosshairBehavior>
            <chart:ChartCrosshairBehavior>
                <chart:ChartCrosshairBehavior.HorizontalLineStyle>
                    <chart:ChartLineStyle 
                               Stroke="Red" 
                               StrokeWidth="2"
                               StrokeDashArray="2,2"/>
                </chart:ChartCrosshairBehavior.HorizontalLineStyle>
                <chart:ChartCrosshairBehavior.VerticalLineStyle>
                    <chart:ChartLineStyle 
                               Stroke="Blue" 
                               StrokeWidth="2"
                               StrokeDashArray="5,3"/>
                </chart:ChartCrosshairBehavior.VerticalLineStyle>
            </chart:ChartCrosshairBehavior>
        </chart:SfCartesianChart.CrosshairBehavior>
        
    </chart:SfCartesianChart>
</ContentPage>
